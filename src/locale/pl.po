msgid "Fuel immunity"
msgstr "Odporność na opróżnienie baku"

msgid "Tire immunity"
msgstr "Odporność na przebicie opony"

msgid "Accident immunity"
msgstr "Odporność na wypadki"

msgid "U-turn immunity"
msgstr "Odporność na zawracanie"

msgid "Speed limit immunity"
msgstr "Odporność na ograniczenie prędkości"

