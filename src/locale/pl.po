msgstr "%{d} mil"

msgid "Let's go!"
msgstr "Jedziemy!"

msgid "By fate's will, you move first."
msgstr "Z woli losu to ty ruszasz pierwszy."

msgid "By fate's will, the bot moves first."
msgstr "Z woli losu pierwszy rusza bot."

msgid "Your turn"
msgstr "Twoja kolej"

msgid "Your turn."
msgstr "Twoja kolej."

msgid "The bot moves."
msgstr "Ruch bota."

msgid "%{nick} moves next."
msgstr "Ruch gracza %{nick}."

msgid "You"
msgstr "Ty"

msgid "Bot"
msgstr "Bot"

msgid "You drew %{card}."
msgstr "Dobrałeś: %{card}."

msgid "The bot drew %{card}."
msgstr "Bot dobrał: %{card}."

msgid "You started the engine."
msgstr "Uruchomiłeś silnik."

msgid "The bot started the engine."
msgstr "Bot uruchomił silnik."

msgid "You refueled."
msgstr "Zatankowałeś."

msgid "The bot refueled."
msgstr "Bot zatankował."

msgid "You fixed the tire."
msgstr "Naprawiłeś oponę."

msgid "The bot fixed the tire."
msgstr "Bot naprawił oponę."

msgid "You repaired the car."
msgstr "Naprawiłeś samochód."

msgid "The bot repaired the car."
msgstr "Bot naprawił samochód."

msgid "You turned forward."
msgstr "Zawróciłeś do przodu."

msgid "The bot turned forward."
msgstr "Bot zawrócił do przodu."

msgid "You removed the speed limit."
msgstr "Zdjąłeś ograniczenie prędkości."

msgid "The bot removed the speed limit."
msgstr "Bot zdjął ograniczenie prędkości."

msgid "You protected yourself from %{hazard}."
msgstr "Ochroniłeś się przed %{hazard}."

msgid "The bot protected itself from %{hazard}."
msgstr "Bot ochronił się przed %{hazard}."

msgid "engine stalling"
msgstr "zgaśnięciem silnika"

msgid "fuel draining"
msgstr "opróżnieniem baku"

msgid "a flat tire"
msgstr "przebiciem opony"

msgid "an accident"
msgstr "wypadkiem"

msgid "being turned around"
msgstr "zawróceniem"

msgid "the speed limit"
msgstr "ograniczeniem prędkości"

msgid "skipping a turn"
msgstr "pominięciem kolejki"

msgid "You drove %{miles}."
msgstr "Przejechałeś %{miles}."

msgid "The bot drove %{miles}."
msgstr "Bot przejechał %{miles}."

msgid "You drove back %{miles}."
msgstr "Przejechałeś do tyłu %{miles}."

msgid "The bot drove back %{miles}."
msgstr "Bot przejechał do tyłu %{miles}."

msgid "You discarded %{card}."
msgstr "Odrzuciłeś %{card}."

msgid "The bot discarded %{card}."
msgstr "Bot odrzucił %{card}."

msgid "You galloped %{miles}."
msgstr "Przejechałeś galopem %{miles}."

msgid "The bot galloped %{miles}."
msgstr "Bot przejechał galopem %{miles}."

msgid "You galloped back %{miles}."
msgstr "Przejechałeś galopem %{miles} do tyłu."

msgid "The bot galloped back %{miles}."
msgstr "Bot przejechał galopem %{miles} do tyłu."

msgid "You saddled up."
msgstr "Osiodłałeś konia."

msgid "The bot saddled up."
msgstr "Bot osiodłał konia."

msgid "You fed the horse."
msgstr "Nakarmiłeś konia."

msgid "The bot fed the horse."
msgstr "Bot nakarmił konia."

msgid "You shod the horse."
msgstr "Podkułeś konia."

msgid "The bot shod the horse."
msgstr "Bot podkuł konia."

msgid "You let the horse rest."
msgstr "Dałeś koniowi odpocząć."

msgid "The bot let the horse rest."
msgstr "Bot dał koniowi odpocząć."

msgid "You were stopped."
msgstr "Zostałeś zatrzymany."

msgid "The bot was stopped."
msgstr "Bot został zatrzymany."

msgid "You ran out of fuel."
msgstr "Zabrakło ci paliwa."

msgid "The bot ran out of fuel."
msgstr "Botowi zabrakło paliwa."

msgid "You must pump up your tire."
msgstr "Musisz napompować oponę."

msgid "The bot must pump up its tire."
msgstr "Bot musi napompować oponę."

msgid "You had an accident."
msgstr "Miałeś wypadek."

msgid "The bot had an accident."
msgstr "Bot miał wypadek."

msgid "You were turned back."
msgstr "Zostałeś zawrócony."

msgid "The bot was turned back."
msgstr "Bot został zawrócony."

msgid "You were speed-limited."
msgstr "Ograniczono ci prędkość."

msgid "The bot was speed-limited."
msgstr "Botowi ograniczono prędkość."

msgid "You skip a turn."
msgstr "Opuszczasz turę."

msgid "The bot skips a turn."
msgstr "Bot opuszcza turę."

msgid "You fell from the saddle."
msgstr "Spadłeś z siodła."

msgid "The bot fell from the saddle."
msgstr "Bot spadł z siodła."

msgid "You must feed your horse."
msgstr "Musisz nakarmić konia."

msgid "The bot must feed its horse."
msgstr "Bot musi nakarmić konia."

msgid "You must shoe your horse."
msgstr "Musisz podkuć konia."

msgid "The bot must shoe its horse."
msgstr "Bot musi podkuć konia."

msgid "You must give your horse a rest."
msgstr "Musisz dać koniowi odpocząć."

msgid "The bot must give its horse a rest."
msgstr "Bot musi dać koniowi odpocząć."

msgid "You protected yourself from falling from the saddle."
msgstr "Ochroniłeś się przed upadkiem z siodła."

msgid "The bot protected itself from falling from the saddle."
msgstr "Bot ochronił się przed upadkiem z siodła."

msgid "You protected your horse from hunger."
msgstr "Ochroniłeś konia przed głodem."

msgid "The bot protected its horse from hunger."
msgstr "Bot ochronił konia przed głodem."

msgid "You protected your horse from losing its horseshoe."
msgstr "Ochroniłeś konia przed zgubieniem podkowy."

msgid "The bot protected its horse from losing its horseshoe."
msgstr "Bot ochronił konia przed zgubieniem podkowy."

msgid "You protected your horse from exhaustion."
msgstr "Ochroniłeś konia przed wyczerpaniem."

msgid "The bot protected its horse from exhaustion."
msgstr "Bot ochronił konia przed wyczerpaniem."

msgid "You protected yourself from being turned back."
msgstr "Ochroniłeś się przed zawróceniem."

msgid "The bot protected itself from being turned back."
msgstr "Bot ochronił się przed zawróceniem."

msgid "You protected yourself from the speed limit."
msgstr "Ochroniłeś się przed ograniczeniem prędkości."

msgid "The bot protected itself from the speed limit."
msgstr "Bot ochronił się przed ograniczeniem prędkości."

msgid "You protected yourself from skipping a turn."
msgstr "Ochroniłeś się przed opuszczeniem tury."

msgid "The bot protected itself from skipping a turn."
msgstr "Bot ochronił się przed opuszczeniem tury."

msgid "You lost all your protections."
msgstr "Straciłeś wszystkie ochrony."

msgid "The bot lost all its protections."
msgstr "Bot stracił wszystkie ochrony."

msgid "You are at the finish line. Congratulations!"
msgstr "Jesteś na mecie. Gratulacje!"

msgid "The bot is at the finish line."
msgstr "Bot jest na mecie."

msgid "The deck ran out. Draw."
msgstr "Talia się skończyła. Remis."

msgid "%{d} miles. You can move."
msgstr "%{d} mil. Możesz jechać."

msgid "%{d} miles. You cannot move: %{reasons}."
msgstr "%{d} mil. Nie możesz jechać: %{reasons}."

msgid "You can move."
msgstr "Możesz jechać."

msgid "Engine stalled"
msgstr "Silnik zgaszony"

msgid "Fuel drained"
msgstr "Benzyna wylana"

msgid "Tire flat"
msgstr "Opona przebita"

msgid "In an accident"
msgstr "W wypadku"

msgid "Speed limited"
msgstr "Prędkość ograniczona"

msgid "Turned back"
msgstr "Skierowany do tyłu"

msgid "The bot is thinking..."
msgstr "Bot myśli..."

msgid "End the game?"
msgstr "Zakończyć grę?"

msgid "No moves yet."
msgstr "Brak ruchów."

msgid "No game in progress."
msgstr "Gra się jeszcze nie rozpoczęła."

msgid "Cannot display the status."
msgstr "Nie mogę pokazać statusu."

msgid "The goal is to be the first to cover the target distance exactly, without overshooting."
msgstr "Celem jest jako pierwszy pokonać zadany dystans dokładnie, bez przekroczenia."

msgid "Distance cards (25/50/75/100/200 miles) move you forward once your car is started and nothing blocks it."
msgstr "Karty dystansu (25/50/75/100/200 mil) przesuwają cię do przodu, gdy silnik jest uruchomiony i nic nie przeszkadza."

msgid "Hazard cards are played against an opponent: stall the engine, empty the tank, flat tire, accident, U-turn, speed limit, skip a turn."
msgstr "Karty szkodzące gra się przeciwko przeciwnikowi: zgaśnięcie silnika, opróżnienie baku, przebicie opony, wypadek, zawracanie, ograniczenie prędkości, pominięcie kolejki."

msgid "Remedy cards fix your own car: start the engine, refuel, fix the tire, repair after accident, end of U-turn, end of speed limit."
msgstr "Karty naprawcze naprawiają twój samochód: uruchomienie silnika, tankowanie, naprawa opony, naprawa po wypadku, koniec zawracania, koniec ograniczenia prędkości."

msgid "Safety cards are played on yourself once and permanently block one kind of hazard. Playing one for the first time keeps your turn."
msgstr "Karty ochronne wykłada się na siebie raz i na stałe blokują jeden rodzaj zagrożenia. Zagranie takiej karty po raz pierwszy zachowuje twoją kolejkę."

msgid "If a card can't take effect (for example, refueling a full tank), it is simply discarded and the turn passes on."
msgstr "Jeśli karta nie może zadziałać (na przykład tankujesz pełny bak), po prostu trafia na stos odrzuconych, a kolejka przechodzi dalej."

msgid "During the game: Ctrl+M — the last move, Ctrl+S — your distance and whether you can move. Escape — end the game."
msgstr "Podczas gry: Ctrl+M — ostatni ruch, Ctrl+S — twój dystans i czy możesz jechać. Escape — zakończ grę."

