msgstr "Ti sei protetto dal salto del turno."

msgid "The bot protected itself from skipping a turn."
msgstr "Il bot si è protetto dal salto del turno."

msgid "You lost all your protections."
msgstr "Hai perso tutte le tue protezioni."

msgid "The bot lost all its protections."
msgstr "Il bot ha perso tutte le sue protezioni."

msgid "You are at the finish line. Congratulations!"
msgstr "Sei al traguardo. Congratulazioni!"

msgid "The bot is at the finish line."
msgstr "Il bot è al traguardo."

msgid "The deck ran out. Draw."
msgstr "Il mazzo è finito. Pareggio."

msgid "%{d} miles. You can move."
msgstr "%{d} miglia. Puoi muoverti."

msgid "%{d} miles. You cannot move: %{reasons}."
msgstr "%{d} miglia. Non puoi muoverti: %{reasons}."

msgid "You can move."
msgstr "Puoi muoverti."

msgid "Engine stalled"
msgstr "Motore spento"

msgid "Fuel drained"
msgstr "Serbatoio vuoto"

msgid "Tire flat"
msgstr "Gomma a terra"

msgid "In an accident"
msgstr "In un incidente"

msgid "Speed limited"
msgstr "Velocità limitata"

