msgid "Distance"
msgstr "Дистанція"

msgid "Number of decks"
msgstr "Кількість колод"

msgid "Each player has their own deck"
msgstr "У кожного гравця своя колода"

msgid "1 common deck"
msgstr "1 спільна колода"

msgid "2 common decks"
msgstr "2 спільні колоди"

msgid "3 common decks"
msgstr "3 спільні колоди"

msgid "4 common decks"
msgstr "4 спільні колоди"

