msgid "Multiplayer"
msgstr "Мультиплеєр"

msgid "Create a game"
msgstr "Створити гру"

msgid "Wait for an invitation"
msgstr "Чекати на запрошення"

msgid "Back"
msgstr "Назад"

msgid "Opponent nickname"
msgstr "Нік суперника"

msgid "Cannot verify the user. Check the connection."
msgstr "Не вдалося перевірити користувача. Перевірте з’єднання."

msgid "There is no user with this name."
msgstr "Користувача з таким іменем немає."

msgid "The user is offline. Send the invitation anyway?"
msgstr "Користувач не в мережі. Усе одно надіслати запрошення?"

msgid "No response from %{nick}."
msgstr "Немає відповіді від %{nick}."

msgid "%{nick} declined the invitation."
msgstr "%{nick} відхилив запрошення."

msgid "Cancel waiting?"
msgstr "Перервати очікування?"

msgid "Exit waiting for invitations?"
msgstr "Вийти з очікування запрошень?"

msgid "%{nick} invites you: %{settings}. Accept?"
msgstr "%{nick} запрошує вас: %{settings}. Прийняти?"

msgid "Cancel waiting for the start?"
msgstr "Перервати очікування початку?"

msgid "The game is out of sync. Return to the menu."
msgstr "Гра розсинхронізувалася. Повернення в меню."

msgid "By fate's will, %{nick} moves first."
msgstr "Волею долі першим ходить %{nick}."

msgid "The game is over."
msgstr "Гру закінчено."

msgid "%{nick} is at the finish line."
msgstr "%{nick} на фініші."

msgid "The bot"
msgstr "Бот"

msgid "Cannot connect to the multiplayer server."
msgstr "Не вдалося підключитися до сервера мультиплеєра."

msgid "Cannot invite %{nick}."
msgstr "Не вдалося запросити %{nick}."

msgid "Cannot accept the invitation."
msgstr "Не вдалося прийняти запрошення."
